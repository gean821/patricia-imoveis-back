# --- App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patricia_imoveis?schema=public

# --- Auth (JWT)
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-isso-em-producao-com-uma-chave-aleatoria-longa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Admin seed (criado no primeiro boot se não existir)
ADMIN_EMAIL=patricia@imoveis.com
ADMIN_PASSWORD=trocar123
ADMIN_NAME=Patricia Lima

# --- Storage (Backblaze B2 — S3-compatible)
# Region vem do painel do bucket (ex: us-west-004, eu-central-003) — não existe "auto" no B2.
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004
STORAGE_BUCKET=patricia-imoveis
# keyID / applicationKey gerados em "App Keys" no painel do B2 (uma key restrita ao bucket)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Se o bucket for privado, sirva via CDN (Cloudflare) na frente do B2; se for público, use a friendly URL do próprio B2
STORAGE_PUBLIC_URL=https://patricia-imoveis.s3.us-west-004.backblazeb2.com

# --- Feed XML (URL pública do site, usada nos feeds)
PUBLIC_SITE_URL=https://patricia-imoveis.vercel.app
