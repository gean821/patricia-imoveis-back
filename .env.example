# --- App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patricia_imoveis?schema=public

# --- Auth (JWT)
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-isso-em-producao-com-uma-chave-aleatoria-longa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Admin seed (criado no primeiro boot se não existir)
ADMIN_EMAIL=patricia@imoveis.com
ADMIN_PASSWORD=trocar123
ADMIN_NAME=Patricia Lima

# --- Storage (Tigris — S3-compatible)
STORAGE_ENDPOINT=https://fly.storage.tigris.dev
STORAGE_REGION=auto
STORAGE_BUCKET=patricia-imoveis
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=https://patricia-imoveis.fly.storage.tigris.dev

# --- Feed XML (URL pública do site, usada nos feeds)
PUBLIC_SITE_URL=https://patricia-imoveis.vercel.app
