generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// AUTH
// =========================================================================

enum Role {
  ADMIN
  CORRETOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([email])
  @@map("users")
}

// =========================================================================
// IMÓVEIS
// =========================================================================

enum TipoImovel {
  APARTAMENTO
  CASA
  SOBRADO
  COBERTURA
  STUDIO
  TERRENO
  CHACARA
  SITIO
  FAZENDA
  COMERCIAL
  GALPAO
  SALA
  CASA_DE_CONDOMINIO
}

enum Finalidade {
  VENDA
  ALUGUEL
  AMBOS
  LANCAMENTO
}

enum StatusImovel {
  DISPONIVEL
  RESERVADO
  NEGOCIACAO
  VENDIDO
  ALUGADO
  INATIVO
}

model Imovel {
  id           String       @id @default(uuid()) @db.Uuid
  codigo       String       @unique @db.VarChar(20)
  titulo       String       @db.VarChar(255)
  descricao    String?      @db.Text
  tipo         TipoImovel
  finalidade   Finalidade   @default(VENDA)
  status     StatusImovel @default(DISPONIVEL)
  destaque   Boolean      @default(false)

  // Localização
  endereco    String  @db.VarChar(255)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String  @db.VarChar(100)
  cidade      String  @db.VarChar(100)
  estado      String  @db.VarChar(2)
  cep         String? @db.VarChar(10)
  latitude    Float?
  longitude   Float?

  // Valores
  valor           Decimal  @db.Decimal(12, 2)
  valorCondominio Decimal? @map("valor_condominio") @db.Decimal(10, 2)
  valorIptu       Decimal? @map("valor_iptu") @db.Decimal(10, 2)

  // Detalhes
  area          Float
  areaTotal     Float?  @map("area_total")
  quartos       Int?
  suites        Int?
  banheiros     Int?
  vagas         Int?
  anoConstrucao Int?    @map("ano_construcao")
  mobiliado     Boolean @default(false)

  caracteristicas String[] // ex: piscina, churrasqueira, portaria 24h

  // Mídia
  fotos          ImovelFoto[]
  videoUrl       String?      @map("video_url") @db.Text
  plantaUrl      String?      @map("planta_url") @db.Text
  tourVirtualUrl String?      @map("tour_virtual_url") @db.Text

  // Portais (flags de publicação)
  publicadoFeed        Boolean @default(true) @map("publicado_feed")
  publicadoOlx         Boolean @default(false) @map("publicado_olx")
  publicadoChavesNaMao Boolean @default(false) @map("publicado_chaves_na_mao")
  publicadoSub100      Boolean @default(false) @map("publicado_sub100")
  publicadoZap         Boolean @default(false) @map("publicado_zap")
  publicadoVivaReal    Boolean @default(false) @map("publicado_viva_real")

  clientesInteressados ClienteImovel[]
  interacoes           Interacao[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@index([tipo])
  @@index([cidade, bairro])
  @@index([finalidade])
  @@index([destaque])
  @@index([deletedAt])
  @@map("imoveis")
}

model ImovelFoto {
  id         String   @id @default(uuid()) @db.Uuid
  imovelId   String   @map("imovel_id") @db.Uuid
  url        String   @db.Text
  storageKey String   @map("storage_key") @db.Text
  legenda    String?  @db.VarChar(255)
  ordem      Int      @default(0)
  isCapa     Boolean  @default(false) @map("is_capa")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("imovel_fotos")
}

model Cliente {
  id          String  @id @default(uuid()) @db.Uuid
  nome        String  @db.VarChar(255)
  telefone    String  @db.VarChar(20)
  email       String? @db.VarChar(255)
  cpf         String? @unique @db.VarChar(14)
  origem      String? @db.VarChar(100) // como conheceu: site, indicação, OLX, ...
  observacoes String? @db.Text

  // Preferências
  tipoDesejado       TipoImovel[]
  finalidadeDesejada Finalidade?  @map("finalidade_desejada")
  bairroDesejado     String?      @map("bairro_desejado") @db.VarChar(100)
  cidadeDesejada     String?      @map("cidade_desejada") @db.VarChar(100)
  valorMin           Decimal?     @map("valor_min") @db.Decimal(12, 2)
  valorMax           Decimal?     @map("valor_max") @db.Decimal(12, 2)
  quartosMin         Int?         @map("quartos_min")
  vagasMin           Int?         @map("vagas_min")

  imoveis    ClienteImovel[]
  interacoes Interacao[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([nome])
  @@index([telefone])
  @@index([email])
  @@index([origem])
  @@index([deletedAt])
  @@map("clientes")
}

model ClienteImovel {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  imovelId  String   @map("imovel_id") @db.Uuid
  interesse Int      @default(3) // 1-5
  nota      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  imovel  Imovel  @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@unique([clienteId, imovelId])
  @@index([clienteId])
  @@index([imovelId])
  @@map("cliente_imovel")
}

// =========================================================================
// INTERAÇÕES / TIMELINE DO CRM
// =========================================================================

enum TipoInteracao {
  CONTATO
  VISITA_AGENDADA
  VISITA_REALIZADA
  PROPOSTA
  CONTRAPROPOSTA
  NEGOCIO_FECHADO
  PERDIDO
  DESISTENCIA
  NOTA
}

model Interacao {
  id        String        @id @default(uuid()) @db.Uuid
  clienteId String        @map("cliente_id") @db.Uuid
  imovelId  String?       @map("imovel_id") @db.Uuid
  tipo      TipoInteracao
  titulo    String?       @db.VarChar(255)
  descricao String?       @db.Text
  data      DateTime      @default(now()) @db.Timestamptz()
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  imovel  Imovel? @relation(fields: [imovelId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([imovelId])
  @@index([data])
  @@map("interacoes")
}

model HeroImagem {
  id         String   @id @default(uuid()) @db.Uuid
  url        String   @db.Text
  storageKey String   @map("storage_key") @db.Text
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([ativo])
  @@map("hero_imagens")
}

model VideoDestaque {
  id         String   @id @default(uuid()) @db.Uuid
  titulo     String   @db.VarChar(255)
  url        String   @db.Text
  storageKey String   @map("storage_key") @db.Text
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([ativo])
  @@map("videos_destaque")
}
